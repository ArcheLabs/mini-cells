{
  "format": "minicells.consumer-language-task.v1",
  "dataset": "roneneldan/TinyStories",
  "tokenizer": "ByteLevel BPE",
  "vocab_size": 2048,
  "max_context": 128,
  "training_sequence_length": 125,
