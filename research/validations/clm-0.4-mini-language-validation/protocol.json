    "existing_private_action": "train only owner private bundle",
    "second_bundle_on_private_reject": false,
    "candidate_kinds": ["direct", "spawn", "private-reuse"]
  },
  "dependency_validation": {
    "formal_local_index": "exact-inverted-index",
    "mapping": "cell_id -> protected_probe_ids",
    "probabilistic_false_negative_index_allowed": false,
    "direct_scope": "union of protected probes for touched base Cells",
    "private_reuse_scope": "protected owner-address probes for private bundle",
