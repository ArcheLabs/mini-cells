    "sequence_length": 256,
    "layers": 4,
    "model_dim": 256,
    "attention_heads": 8,
    "tie_embedding_lm_head": true,
    "positional_encoding": "parameter-free-deterministic",
    "shared_dense_layers": {
      "layers": [1, 2],
      "ffn_hidden": 768,
      "continual_phase_mutable": false
    },
    "cell_layers": {
      "layers": [3, 4],
      "base_cells_per_layer": 32,
      "base_cell_hidden": 32,
      "topk_base": 2,
      "continual_phase_mutable": "only-routed-base-cells-or-owner-private-growth-cells"
    },
    "continual_frozen_parameters": [
      "token_embeddings",
      "attention",
      "normalization",
      "dense_ffn_layers_1_2",
      "lm_head",
      "all_non-touched-base-cells"
    ]
  },
  "addressing": {
    "formal_router": "deterministic-out-of-band-address-hash",
    "address_visible_in_token_sequence": false,
    "route_formula": "stable_hash(protocol_salt, layer_id, address_id) -> two distinct base Cell IDs",
    "mutable_hidden_state_dependency": false,
    "base_route_rewrite_allowed": false,
    "private_route_addition": "monotonic-only",
    "shadow_semantic_router": {
      "allowed": true,
      "controls_commit": false,
      "controls_validation_scope": false,
      "controls_growth": false
    }
  },
  "growth": {
    "unit": "private-growth-bundle",
    "cells_per_bundle": 2,
    "layers": [3, 4],
    "cell_hidden": 32,
    "approx_weights_per_bundle": 32768,
    "zero_output_initialization": true,
    "owner_scope": "exact-address-id",
    "max_bundles_per_address_m1": 1,
    "atomic_commit": "parameters-plus-private-route",
    "failed_probationary_growth_deleted": true,
    "reuse_rule": "after bundle commit, later updates for the address train only that bundle",
    "second_generation_allowed_m1": false
  },
  "base_training": {
    "target_tokens": 30000000,
    "token_tolerance_fraction": 0.01,
    "mixture_token_fraction": {
      "language_carrier": 0.60,
      "controlled_base_math": 0.20,
      "controlled_base_story": 0.20
    },
    "language_carrier": "pinned TinyStories subset or equivalent repository-supported corpus",
    "formal_lock_required": [
      "dataset_revision",
      "sample_manifest_hash",
      "preprocessing_version",
      "tokenizer_manifest_hash",
      "tokenizer_hash"
    ],
    "base_math": [
      "small_integer_addition",
      "small_integer_subtraction",
      "comparison",
      "simple_one_step_verbal_arithmetic"
    ],
    "base_story": "generated natural-language micro-world declarative and QA examples",
    "base_route_coverage": "all 32 base Cells in each Cell layer must exceed the protocol-lock minimum activation count"
  },
  "continual_curriculum": {
    "total_transactions": 192,
    "same_semantic_schedule_across_formal_model_seeds": true,
    "math": {
      "transactions": 96,
      "addresses": 12,
      "visits_per_address": 8,
      "families": [
        "multiplication",
        "exact_integer_division",
        "modulo",
        "precedence_and_two_step_expressions",
        "bounded_affine_transforms",
        "synthetic_binary_operators"
