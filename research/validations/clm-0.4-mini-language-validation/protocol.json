    "story": {
      "transactions": 96,
      "addresses": 24,
      "visits_per_address": 4,
      "operations": ["append", "supersede"],
      "supersede_rule": "remove protection only for the exact superseded knowledge key; unrelated facts remain protected"
    },
    "per_transaction": {
      "train_examples": 64,
      "new_validation_examples": 128,
      "protected_probes_added_on_commit": 32
    },
    "truth_advances_on_reject": true,
    "formal_lock_required": ["curriculum_generator_version", "transaction_manifest_hash"]
  },
  "transaction": {
    "direct_candidate": "train four routed base Cells: Top-2 in each of two Cell layers",
