  "decision_question": "Can the dependency-scoped transactional growth loop preserve useful stability and plasticity in a real autoregressive token-level language model under a controlled continual-learning curriculum?",
  "interpretation_scope": {
    "token_level_language_model": true,
    "controlled_math": true,
    "controlled_story_worlds": true,
    "explicit_stable_addressing": true,
    "autonomous_semantic_routing": false,
