{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minicells.shadow-cell-validation-001-v2.result",
  "type": "object",
  "required": ["validation_id", "protocol_sha256", "implementation_manifest_sha256", "implementation_commit", "checkpoint_sha256", "dataset_sha256", "seed", "phase", "status", "arms", "controls", "validity"],
  "properties": {
    "validation_id": {"const": "shadow-cell-validation-001-v2-developmental-maturation"},
    "protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_manifest_sha256": {"type": ["string", "null"]},
    "implementation_commit": {"type": "string", "minLength": 1},
    "runtime_git_commit": {"type": "string", "minLength": 1},
    "checkpoint_sha256": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "phase": {"enum": ["smoke", "formal"]},
    "status": {"type": "string"},
    "scientific_decision": {"type": "boolean"},
    "arms": {"type": "object", "required": ["corrected_direct", "shadow_full", "shadow_oracle", "shadow_sketch", "task_id_shadow"]},
    "controls": {"type": "object", "required": ["direct_interp", "shuffled_gate"]},
    "validity": {"type": "object", "required": ["protocol_hash_matches_locked_protocol", "required_arms_completed", "all_maturity_values_evaluated", "absolute_retention_passes"]}
  }
}
