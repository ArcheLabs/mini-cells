{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archelabs.org/schemas/jam-knowledge-concept-v1.json",
  "title": "JAM Knowledge Concept v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "category", "canonical_fact", "relations", "misconceptions", "source_refs", "source_pin", "tags", "difficulty", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^jam\\.[a-z0-9_]+\\.[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "enum": ["foundations", "block_state", "consensus", "services", "authorization", "work", "guarantees", "accumulation", "pvm", "serialization"]},
    "canonical_fact": {"type": "string", "minLength": 20},
    "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["target", "statement"], "properties": {"target": {"type": "string", "pattern": "^jam\\."}, "statement": {"type": "string", "minLength": 10}}}},
    "misconceptions": {"type": "array", "items": {"type": "string", "minLength": 10}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^text/.+\\.tex$"}},
    "source_pin": {"const": "graypaper-0.8.0-e5375148"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "difficulty": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"const": "canonical"}
  }
}
