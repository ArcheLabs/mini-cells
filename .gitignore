*.egg-info/
target/
.deps/
.local/
apps/web/node_modules/
apps/web/dist/
apps/web/tsconfig.tsbuildinfo
# Kaggle credentials and generated workflow downloads must stay out of Git.
.kaggle/
kaggle.json
.env
.env.*
!.env.example
kaggle-output/
prepared-notebook/
experiments/00*-*/outputs/**
!experiments/00*-*/outputs/**/.gitkeep
experiments/00*-*/checkpoints/**
!experiments/00*-*/checkpoints/.gitkeep
# Pipeline v2 transient packages and per-experiment scratch outputs.
prepared-assets/
research/experiments/00*-*/outputs/**
!research/experiments/00*-*/outputs/.gitkeep
research/artifacts/**/*.pt

# Pinned source checkout prepared by GitHub Actions.
/experiment-source/

# Actions-managed immutable input identity cache.
/.research-input-state/
